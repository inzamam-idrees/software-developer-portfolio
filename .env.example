NEXT_PUBLIC_GTM =
NEXT_PUBLIC_APP_URL = 
TELEGRAM_BOT_TOKEN = 
TELEGRAM_CHAT_ID = 
GMAIL_PASSKEY = 
EMAIL_ADDRESS =
# Server-only Google reCAPTCHA verification secret.
RECAPTCHA_SECRET_KEY=
# Verified public HTTPS origin; leave empty until deployment is confirmed.
SITE_URL=
# Phase 5 private preview. Generate a scrypt hash with the documented helper.
# Note: Escape '$' as '\$' in .env files. Locally, Next.js also expanded '$' when
# the hash was set as a shell environment variable; escape there too if sign-in fails.
PORTFOLIO_ADMIN_PASSWORD_HASH=
# At least 32 random characters. Never expose this with a NEXT_PUBLIC_ prefix.
PORTFOLIO_ADMIN_SESSION_SECRET=
# Optional filesystem-backed data root for local/persistent-volume hosts only.
# Leave unset on the current read-only Netlify architecture.
PORTFOLIO_DATA_DIR=
# Admin content storage: filesystem (local files; default in development),
# github (commit edits to the repository; production), or readonly (default in production).
PORTFOLIO_CONTENT_STORE=
# Fine-grained GitHub token limited to this repository with Contents read/write. Server-only.
GITHUB_CONTENT_TOKEN=
# Repository receiving admin commits, as owner/name.
GITHUB_CONTENT_REPO=
# Branch the deployment builds from; admin commits land here and trigger a redeploy.
GITHUB_CONTENT_BRANCH=
